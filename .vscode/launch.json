{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Demos",
            "type": "debugpy",
            "request": "launch",
            "program": "demos",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Run Last Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "demos",
            "args": [ "last" ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Run Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "test",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Update documentation",
            "type": "debugpy",
            "request": "launch",
            "program": "docs",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
